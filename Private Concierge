<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Wiktoria & Kamil | Private Concierge</title>
    <meta name="description" content="Prywatna przestrzeń dla gości weselnych.">
    <meta name="theme-color" content="#F5F2EB">
    
    <!-- Fonts: Cormorant Garamond & Montserrat -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Montserrat:wght@300;400;500&display=swap" rel="stylesheet">

    <style>
        /* =========================================
           1. CORE VARIABLES & RESET
           ========================================= */
        :root {
            /* Palette: Mulberry Grove */
            --bg-white: #FFFFFF;      
            --bg-ivory: #F5F2EB;      
            --bg-mulberry: #26161C;   
            --accent-burgundy: #5D2E36; 
            
            --text-main: #3D3834;     
            --text-accent: #26161C;   
            --gold-muted: #9C8C74;    
            --gold-light: #C2B49A;    
            --error-red: #8a3b3b;     

            /* Typography */
            --font-serif: 'Cormorant Garamond', serif;
            --font-sans: 'Montserrat', sans-serif;
            
            /* Motion Design - PRZYWRÓCONA PŁYNNOŚĆ */
            /* NAPRAWA: Poprawna nazwa zmiennej używana w gate-content-wrapper */
            --anim-text-fade: 1.2s ease-in-out;      
            --anim-slow: 3.5s cubic-bezier(0.19, 1, 0.22, 1); /* Wolniejsze, majestatyczne wrota */
            --ease-luxury: cubic-bezier(0.2, 1, 0.3, 1);
            
            /* Timing Constants */
            --gate-delay: 1.0s; /* Mała pauza po zniknięciu tekstu */
            --hero-start-time: 2.0s; /* Zgranie z wolniejszymi wrotami */
        }

        * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

        body {
            background-color: var(--bg-ivory);
            color: var(--text-main);
            font-family: var(--font-serif);
            overflow-x: hidden; 
            width: 100%;
            overscroll-behavior-y: none; 
        }
        
        body:not(.access-granted) { overflow: hidden; height: 100vh; position: fixed; width: 100%; }

        /* Texture Overlay */
        .texture-overlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            pointer-events: none; 
            z-index: 9999; 
            opacity: 0.04; 
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
        }

        /* Shared Animations */
        @keyframes shake {
            10%, 90% { transform: translate3d(-1px, 0, 0); }
            20%, 80% { transform: translate3d(2px, 0, 0); }
            30%, 50%, 70% { transform: translate3d(-4px, 0, 0); }
            40%, 60% { transform: translate3d(4px, 0, 0); }
        }

        /* Sekcje - Globalny Padding (Mobile First) */
        section {
            padding: 6rem 1.5rem; /* Zwiększony oddech pionowy, bezpieczny poziomy */
            position: relative;
        }

        @media (min-width: 768px) {
            section { padding: 8rem 4rem; }
        }

        /* =========================================
           2. COMPONENT: ACCESS GATE
           ========================================= */
        #AccessGate {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            z-index: 1000; display: flex; justify-content: center; align-items: center;
        }

        .gate-panel {
            position: absolute; top: 0; width: 51%; height: 100%;
            background-color: var(--bg-mulberry); z-index: 10;
            box-shadow: none; will-change: transform;
            transform: translate3d(0,0,0);
            transition: transform var(--anim-slow);
        }

        .gate-panel.left { left: 0; transform-origin: left center; }
        .gate-panel.right { right: 0; transform-origin: right center; }

        body.access-granted .gate-panel.left { transform: translate3d(-100%, 0, 0); transition-delay: var(--gate-delay); }
        body.access-granted .gate-panel.right { transform: translate3d(100%, 0, 0); transition-delay: var(--gate-delay); }
        body.access-granted #AccessGate { pointer-events: none; }

        .gate-content-wrapper {
            position: relative; z-index: 20;
            display: flex; flex-direction: column; align-items: center;
            width: 100%; max-width: 320px;
            opacity: 1; transform: scale(1);
            /* NAPRAWA: Zmienna teraz pasuje do definicji w :root */
            transition: opacity var(--anim-text-fade), transform var(--anim-text-fade);
        }
        
        body.access-granted .gate-content-wrapper { opacity: 0 !important; transform: scale(0.98); pointer-events: none; transition-delay: 0s; }

        .gate-dialog { width: 100%; text-align: center; }

        .gate-label {
            display: block;
            font-family: var(--font-sans); font-size: 0.65rem; letter-spacing: 0.2em;
            text-transform: uppercase; color: var(--gold-light); margin-bottom: 1.5rem; opacity: 0.8;
            text-align: center;
        }

        .gate-input {
            width: 100%; background: transparent; border: none;
            border-bottom: 1px solid rgba(194, 180, 154, 0.3); 
            color: var(--bg-ivory); font-family: var(--font-serif); font-size: 2.5rem; 
            text-align: center; padding: 0.5rem 0; margin-bottom: 1rem;
            outline: none; letter-spacing: 0.3em; text-transform: uppercase;
            transition: border-color 0.5s ease; border-radius: 0;
        }

        .gate-input:focus { border-bottom-color: var(--gold-light); }
        .gate-input.input-error { border-bottom-color: var(--error-red); color: var(--error-red); animation: shake 0.5s cubic-bezier(.36,.07,.19,.97) both; }
        .gate-feedback { height: 1.5rem; font-family: var(--font-sans); font-size: 0.6rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--error-red); opacity: 0; transition: opacity 0.4s ease; text-align: center; }
        .gate-feedback.visible { opacity: 0.8; }

        /* =========================================
           3. SECTION: HERO PRESENCE (Ivory)
           ========================================= */
        #HeroPresence {
            background-color: var(--bg-ivory);
            min-height: 100vh;
            display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center;
            visibility: visible; 
            /* Hero ma własny padding dla centrowania */
            padding: 2rem; 
        }

        .stagger-reveal {
            opacity: 0; transform: translateY(30px); visibility: hidden; 
            transition: opacity 1.5s ease, transform 1.5s cubic-bezier(0.22, 1, 0.36, 1), visibility 0s linear;
            will-change: opacity, transform;
        }

        body.access-granted .stagger-reveal { opacity: 1; transform: translateY(0); visibility: visible; }
        
        body.access-granted .delay-1 { transition-delay: calc(var(--hero-start-time) + 0.0s); } 
        body.access-granted .delay-2 { transition-delay: calc(var(--hero-start-time) + 0.3s); }
        body.access-granted .delay-3 { transition-delay: calc(var(--hero-start-time) + 0.7s); }
        body.access-granted .delay-4 { transition-delay: calc(var(--hero-start-time) + 1.2s); }
        body.access-granted .delay-5 { transition-delay: calc(var(--hero-start-time) + 1.6s); }

        .hero-pre-title { font-family: var(--font-sans); font-size: 0.7rem; letter-spacing: 0.3em; text-transform: uppercase; color: var(--gold-muted); margin-bottom: 2rem; display: block; }
        .hero-greeting { font-size: clamp(2rem, 5vw, 3rem); font-style: italic; font-weight: 300; color: var(--text-main); margin-bottom: 0.5rem; }
        .hero-name { font-size: clamp(3rem, 10vw, 6rem); color: var(--text-accent); line-height: 1.1; margin-bottom: 3rem; display: block; }
        .hero-sentiment { font-size: 1.1rem; line-height: 1.7; color: var(--text-main); max-width: 500px; margin-bottom: 4rem; }
        .hero-date { font-family: var(--font-sans); font-size: 0.75rem; letter-spacing: 0.25em; color: var(--gold-muted); border-top: 1px solid rgba(156, 140, 116, 0.3); padding-top: 1.5rem; }

        /* =========================================
           4. SECTION: THE SENTIMENT (Mulberry)
           ========================================= */
        #TheSentiment {
            background-color: var(--bg-mulberry);
            color: var(--bg-ivory);
            min-height: 70vh;
            display: flex; justify-content: center; align-items: center; text-align: center;
        }

        .sentiment-content {
            max-width: 600px; 
            opacity: 0; transform: translateY(40px);
            transition: opacity 1.2s ease-out, transform 1.4s var(--ease-luxury);
        }
        .sentiment-content.visible { opacity: 1; transform: translateY(0); }

        .sentiment-ornament { font-size: 1.5rem; color: var(--gold-light); display: block; margin-bottom: 1.5rem; }
        .sentiment-text { font-size: 1.3rem; line-height: 1.7; font-weight: 300; margin-bottom: 2rem; color: rgba(245, 242, 235, 0.9); }
        .sentiment-request { font-size: 1.3rem; line-height: 1.7; font-weight: 300; margin-top: 3rem; padding-top: 2rem; border-top: 1px solid rgba(194, 180, 154, 0.3); color: rgba(245, 242, 235, 0.9); }
        .sentiment-date { color: var(--gold-light); font-style: italic; }
        .sentiment-closing { font-size: 1.4rem; font-style: italic; color: var(--gold-light); margin-top: 2rem; }

        .sentiment-name { font-weight: 400; }

        /* =========================================
           5. SECTION: EVENT DETAILS (White)
           ========================================= */
        #EventDetails { background-color: var(--bg-white); }

        .acts-container { display: flex; flex-direction: column; gap: 5rem; max-width: 1000px; margin: 0 auto; }
        @media(min-width: 768px) { .acts-container { flex-direction: row; align-items: stretch; gap: 0; } }

        .act {
            flex: 1; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 1rem;
            opacity: 0; transform: translateY(30px); transition: opacity 1.2s ease, transform 1.2s ease;
        }
        .act.visible { opacity: 1; transform: translateY(0); }

        .act-number { font-family: var(--font-sans); font-size: 0.65rem; letter-spacing: 0.3em; color: var(--gold-muted); text-transform: uppercase; margin-bottom: 0.5rem; display: block;}
        .act-title { font-size: 3rem; font-style: italic; color: var(--text-accent); line-height: 1; margin-bottom: 0.5rem; }
        .act-subtitle { font-family: var(--font-sans); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.15em; color: var(--text-main); margin-bottom: 1.5rem; opacity: 0.7; }
        .act-time { font-size: 1.2rem; margin-bottom: 1rem; color: var(--text-main); font-variant-numeric: oldstyle-nums; }
        .act-location { font-size: 1.3rem; line-height: 1.6; max-width: 320px; font-weight: 300; padding-bottom: 1.5rem; flex-grow: 0; }
        
        .direction-link {
            font-size: 1.1rem; font-style: italic; color: var(--gold-muted); text-decoration: none;
            border-bottom: 1px solid rgba(156, 140, 116, 0.3); padding-bottom: 3px; margin-top: auto; display: inline-block;
            transition: all 0.4s ease;
        }
        .direction-link:hover { color: var(--text-accent); border-bottom-color: var(--text-accent); }
        
        .act-divider { width: 1px; height: auto; min-height: 150px; background-color: var(--gold-light); margin: 2rem auto; opacity: 0.4; align-self: stretch; }
        @media(min-width: 768px) { .act-divider { margin: 4rem 0; } }

        /* =========================================
           6. SECTION: DRESS CODE (Mulberry Ribbon)
           ========================================= */
        #DressCode {
            background-color: var(--bg-mulberry); color: var(--bg-ivory);
            padding: 4rem 1.5rem; /* Compact padding */
            border-top: 1px solid rgba(164, 142, 104, 0.2);
            border-bottom: 1px solid rgba(164, 142, 104, 0.2);
        }

        .dc-compact-wrapper {
            max-width: 1000px; margin: 0 auto;
            display: flex; flex-direction: column; align-items: center; gap: 2rem;
            opacity: 0; transform: translateY(20px); transition: opacity 1.2s ease, transform 1.2s ease;
        }
        .dc-compact-wrapper.visible { opacity: 1; transform: translateY(0); }
        @media(min-width: 900px) { .dc-compact-wrapper { flex-direction: row; gap: 4rem; } }

        .dc-label-compact { font-family: var(--font-sans); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.25em; color: var(--gold-light); white-space: nowrap; flex-shrink: 0; }
        .dc-text-compact { font-size: 1.3rem; color: rgba(245, 242, 235, 0.9); font-style: italic; text-align: center; line-height: 1.5; max-width: 600px; }
        
        .dc-dots-compact { display: flex; gap: 0.8rem; align-items: center; flex-shrink: 0; }
        .mini-dot { width: 14px; height: 14px; border-radius: 50%; border: 1px solid rgba(255,255,255,0.15); }
        .mini-dot.bottle-green { background-color: #2F4538; }
        .mini-dot.olive { background-color: #606852; }
        .mini-dot.burgundy { background-color: #5D2E36; }
        .mini-dot.chocolate { background-color: #4E3629; }
        .mini-dot.champagne { background-color: #D6CFC7; }

        /* =========================================
           7. SECTION: RSVP (Ivory)
           ========================================= */
        #RSVP_Formal { background-color: var(--bg-ivory); color: var(--text-main); text-align: center; }
        
        .rsvp-container {
            max-width: 600px; margin: 0 auto; 
            /* Brak paddingu pionowego dla balansu z sekcją */
            padding: 0 1rem;
            display: flex; flex-direction: column;
            opacity: 0; transform: translateY(40px); transition: opacity 1.2s ease, transform 1.2s var(--ease-luxury);
        }
        .rsvp-container.visible { opacity: 1; transform: translateY(0); }

        .rsvp-header { font-family: var(--font-sans); font-size: 0.7rem; letter-spacing: 0.3em; text-transform: uppercase; color: var(--gold-muted); margin-bottom: 2rem; display: block; }
        .rsvp-question { font-size: 2rem; color: var(--text-accent); margin-bottom: 3rem; line-height: 1.3; font-weight: 400; font-style: italic; }

        .rsvp-step { display: none; flex-direction: column; align-items: center; gap: 2rem; opacity: 0; transform: translateY(20px); transition: opacity 0.8s ease, transform 0.8s var(--ease-luxury); }
        .rsvp-step.active { display: flex; opacity: 1; transform: translateY(0); }

        /* Inputs & Radios (Styled for Ivory BG) */
        .rsvp-choice-wrapper { display: flex; flex-direction: column; gap: 1.5rem; width: 100%; max-width: 400px; }
        .rsvp-radio-label { cursor: pointer; padding: 1rem; text-align: center; }
        .rsvp-radio-text { font-size: 1.3rem; color: var(--text-main); transition: color 0.4s ease, transform 0.4s ease; display: inline-block; }
        .rsvp-radio-label input { display: none; }
        .rsvp-radio-label input:checked + .rsvp-radio-text { color: var(--text-accent); transform: scale(1.05); font-style: italic; border-bottom: 1px solid var(--gold-muted); padding-bottom: 2px; }

        .input-wrapper { display: flex; flex-direction: column; width: 100%; margin-bottom: 2rem; }
        .input-wrapper label { font-family: var(--font-sans); font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.2em; color: var(--gold-muted); margin-bottom: 1rem; text-align: center; }
        .input-wrapper input {
            background: transparent; border: none; border-bottom: 1px solid rgba(194, 180, 154, 0.3);
            padding: 0.8rem 0; font-family: var(--font-serif); font-size: 1.5rem; color: var(--text-accent);
            text-align: center; outline: none; border-radius: 0;
        }
        .input-wrapper input:focus { border-bottom-color: var(--gold-light); }
        .input-wrapper input::placeholder {
            color: rgba(156, 140, 116, 0.2);
            font-style: italic;
            font-size: 1.2rem;
        }

        /* Buttons */
        .nav-actions { margin-top: 1rem; display: flex; flex-direction: column; gap: 1rem; align-items: center; }
        .next-arrow-btn { background: none; border: none; font-family: var(--font-serif); font-size: 1.2rem; font-style: italic; color: var(--gold-muted); padding: 1rem; }
        
        .submit-btn {
            background-color: var(--bg-mulberry); color: var(--bg-ivory); border: none; padding: 1.2rem 3rem;
            font-family: var(--font-sans); font-size: 0.75rem; letter-spacing: 0.25em; text-transform: uppercase;
            cursor: pointer; min-width: 250px; transition: all 0.5s var(--ease-luxury);
        }
        .submit-btn:hover { background-color: var(--text-main); transform: translateY(-2px); }
        
        /* New Elegant Submit Button for Decline */
        .submit-btn-elegant {
            position: relative; cursor: pointer; display: inline-flex; align-items: center; justify-content: center;
            padding: 1.2rem 4rem; background-color: transparent;
            color: var(--text-main); border: 1px solid var(--text-main);
            transition: all 0.5s var(--ease-luxury); overflow: hidden;
            font-family: var(--font-sans); font-size: 0.75rem; letter-spacing: 0.25em; text-transform: uppercase;
            min-width: 250px;
        }
        .submit-btn-elegant::before {
            content: ''; position: absolute; top: 0; left: 0; width: 0%; height: 100%;
            background-color: var(--accent-burgundy); transition: width 0.6s var(--ease-luxury); z-index: 0;
        }
        .submit-btn-elegant:hover { border-color: var(--accent-burgundy); }
        .submit-btn-elegant:hover::before { width: 100%; }
        
        .btn-text { position: relative; z-index: 1; transition: color 0.6s ease; }
        .submit-btn-elegant:hover .btn-text { color: var(--bg-ivory); }

        .back-btn { background: none; border: none; font-family: var(--font-sans); font-size: 0.6rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold-muted); opacity: 0.7; padding: 1rem; }
        .back-btn:hover { opacity: 1; }

        /* Success State */
        #rsvpSuccessMessage { display: none; flex-direction: column; align-items: center; gap: 2rem; opacity: 0; transition: opacity 1.5s ease; }
        #rsvpSuccessMessage.visible { opacity: 1; }
        .success-text { font-size: 1.8rem; color: var(--text-accent); font-style: italic; max-width: 500px; line-height: 1.4; }
        
        .success-tools { display: flex; flex-direction: column; gap: 2rem; margin-top: 1rem; width: 100%; align-items: center; }
        
        /* ZMIANA: Styl przycisków kalendarza - oddzielne linki tekstowe BEZ strzałki */
        .calendar-btn-group {
            display: flex;
            flex-direction: column; /* Stack on mobile */
            gap: 1.5rem;
            justify-content: center;
            align-items: center;
            width: 100%;
        }

        @media (min-width: 600px) {
            .calendar-btn-group {
                flex-direction: row;
                gap: 2rem;
            }
        }
        
        /* Styl bazowany na .direction-link */
        .calendar-styled-link {
            font-family: var(--font-serif);
            font-size: 1.1rem;
            font-style: italic;
            color: var(--gold-muted);
            text-decoration: none;
            border: none;
            background: transparent;
            border-bottom: 1px solid rgba(156, 140, 116, 0.3);
            padding-bottom: 3px;
            margin-top: auto;
            display: inline-block;
            transition: all 0.4s ease;
            cursor: pointer;
        }

        /* Usunięto ::after ze strzałką */
        .calendar-styled-link:hover {
            color: var(--text-accent);
            border-bottom-color: var(--text-accent);
        }

        .contact-info-block { font-size: 1.1rem; color: var(--text-main); margin-top: 1.5rem; opacity: 0.7; }
        .contact-phone { color: var(--text-accent); text-decoration: none; border-bottom: 1px solid transparent; }

        /* =========================================
           8. SECTION: COLLECTIVE TEASER (White)
           ========================================= */
        #CollectiveTeaser {
            background-color: var(--bg-white);
            color: var(--text-main);
            text-align: center;
            border-top: 1px solid rgba(156, 140, 116, 0.1);
        }

        .teaser-wrapper {
            max-width: 600px; margin: 0 auto;
            display: flex; flex-direction: column; align-items: center; gap: 1.5rem;
            opacity: 0; transform: translateY(20px); transition: opacity 1.2s ease, transform 1.2s var(--ease-luxury);
        }
        .teaser-wrapper.visible { opacity: 1; transform: translateY(0); }

        .teaser-label { font-family: var(--font-sans); font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.2em; color: var(--gold-muted); }
        .teaser-text { font-size: 1.3rem; font-style: italic; color: var(--text-main); line-height: 1.5; }
        
        .teaser-link {
            text-decoration: none; display: inline-flex; align-items: center; gap: 0.8rem; margin-top: 1rem;
            color: var(--text-main); font-family: var(--font-sans); font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.2em;
            transition: all 0.4s var(--ease-luxury);
        }
        .teaser-arrow { font-size: 1.2rem; line-height: 0; font-weight: 300; transition: transform 0.4s ease; }
        .teaser-link:hover { color: var(--text-accent); }
        .teaser-link:hover .teaser-arrow { transform: translateX(4px); }

        /* =========================================
           9. SECTION: FOOTER (Mulberry)
           ========================================= */
        #FinalNote {
            background-color: var(--bg-mulberry); 
            color: var(--bg-ivory);
            padding: 6rem 2rem;
            text-align: center;
            
            position: relative;
        }

        .footer-wrapper {
            display: flex; flex-direction: column; gap: 1.5rem; align-items: center;
            opacity: 0; transform: translateY(40px); transition: opacity 1.2s ease, transform 1.2s var(--ease-luxury);
        }
        .footer-wrapper.visible { opacity: 1; transform: translateY(0); }

        .footer-monogram { font-family: var(--font-serif); font-size: 2.5rem; color: var(--gold-light); letter-spacing: 0.1em; opacity: 0.8; }
        .footer-message { font-size: 1.3rem; color: rgba(245, 242, 235, 0.8); margin-top: 1rem; font-style: italic; line-height: 1.5; }
        #footerGuestName { color: var(--gold-light); display: block; margin-top: 0.5rem; }
        .footer-end { font-family: var(--font-sans); font-size: 0.5rem; text-transform: uppercase; letter-spacing: 0.3em; color: rgba(245, 242, 235, 0.3); margin-top: 2rem; }

    </style>
</head>
<body>

    <!-- Szum analogowy -->
    <div class="texture-overlay"></div>

    <!-- 1. ACCESS GATE -->
    <div id="AccessGate">
        <div class="gate-panel left"></div>
        <div class="gate-panel right"></div>
        <div class="gate-content-wrapper">
            <div class="gate-dialog">
                <label for="guestCode" class="gate-label">Twój klucz osobisty</label>
                <input type="text" id="guestCode" class="gate-input" placeholder="– – – – –" maxlength="10" autocomplete="off" spellcheck="false">
                <div id="gateFeedback" class="gate-feedback">Kod nie został rozpoznany</div>
            </div>
        </div>
    </div>

    <!-- 2. HERO PRESENCE -->
    <section id="HeroPresence">
        <span id="heroPreTitle" class="hero-pre-title stagger-reveal delay-1">Twój Osobisty Concierge</span>
        <div class="hero-greeting-wrapper">
            <span class="hero-greeting stagger-reveal delay-2">Witamy Cię,</span>
            <span id="heroGuestName" class="hero-name stagger-reveal delay-3">Szanowny Gościu</span>
        </div>
        <p id="heroSentiment" class="hero-sentiment stagger-reveal delay-4">
            Ten dzień nie byłby kompletny bez Twojej obecności.<br>
            Oto szczegóły Ceremonii Zaślubin oraz Przyjęcia.
        </p>
        <div class="hero-date stagger-reveal delay-5">08.08.2027</div>
    </section>

    <!-- 3. THE SENTIMENT -->
    <section id="TheSentiment">
        <div class="sentiment-content scroll-reveal">
            <span class="sentiment-ornament">❦</span>
            <p class="sentiment-text" id="sentimentText1">Papierowe zaproszenie było pierwszym, eleganckim gestem.<br>Jako Państwa osobisty Concierge, pragnę zadbać o każdy detal tej podróży.</p>
            <p class="sentiment-text" id="sentimentText2">Ta cyfrowa przestrzeń powstała, by dopełnienie formalności<br>stało się dla Was czystą przyjemnością i zwieńczeniem przygotowań.</p>
            <p class="sentiment-request">Uprzejmie prosimy o potwierdzenie obecności<br>do dnia <span class="sentiment-date">1 maja 2027</span>.</p>
            <p class="sentiment-closing"><span id="sentimentGuestName" class="sentiment-name">Drogi Gościu</span>,<br><span id="sentimentClosingText">z niecierpliwością oczekujemy Państwa przybycia.</span></p>
        </div>
    </section>

    <!-- 4. EVENT DETAILS -->
    <section id="EventDetails">
        <div class="acts-container">
            <div class="act scroll-reveal">
                <span class="act-number">Akt I</span>
                <h2 class="act-title">Przysięga</h2>
                <span class="act-subtitle">Ceremonia Zaślubin</span>
                <div class="act-time">Godzina 15:00</div>
                <address class="act-location">Kościół Parafialny<br>Jawornik</address>
                <a href="https://www.google.com/maps/dir//Kościół+Podwyższenia+Krzyża+Świętego,+Jawornik+1,+32-400+Jawornik" target="_blank" class="direction-link">Prowadź do celu</a>
            </div>
            <div class="act-divider scroll-reveal"></div>
            <div class="act scroll-reveal" style="transition-delay: 0.2s;">
                <span class="act-number">Akt II</span>
                <h2 class="act-title">Celebracja</h2>
                <span class="act-subtitle">Przyjęcie Weselne</span>
                <div class="act-time">Godzina 17:00</div>
                <address class="act-location">Villa Rezydent<br>Rudnik</address>
                <a href="https://www.google.com/maps/dir//Villa+Rezydent,+Słoneczna+1,+32-440+Rudnik" target="_blank" class="direction-link">Prowadź do celu</a>
            </div>
        </div>
    </section>

    <!-- 5. DRESS CODE (WSTĘGA - BORDOWA) -->
    <section id="DressCode">
        <div class="dc-compact-wrapper scroll-reveal">
            <span class="dc-label-compact">Inspiracja</span>
            <p class="dc-text-compact">
                Jeśli pragniecie nawiązać do estetyki przyjęcia, zachęcamy Panie do kreacji w tych odcieniach,<br>
                a Panów do doboru dodatków – krawata, muchy lub poszetki.
            </p>
            <div class="dc-dots-compact">
                <span class="mini-dot bottle-green" title="Butelkowa Zieleń"></span>
                <span class="mini-dot olive" title="Oliwka"></span>
                <span class="mini-dot burgundy" title="Burgund"></span>
                <span class="mini-dot chocolate" title="Czekolada"></span>
                <span class="mini-dot champagne" title="Szampański"></span>
            </div>
        </div>
    </section>

    <!-- 6. RSVP FORMAL (THE DIALOGUE) -->
    <section id="RSVP_Formal">
        <div class="rsvp-container scroll-reveal">
            <div id="rsvpContent">
                <span class="rsvp-header">Moment Decyzji</span>
                <form id="rsvpForm" class="rsvp-form">
                    
                    <!-- KROK 1: Decyzja -->
                    <div id="step-1" class="rsvp-step active">
                        <h2 class="rsvp-question" id="questionAttendance">Czy zaszczycisz nas swoją obecnością?</h2>
                        <div class="rsvp-choice-wrapper">
                            <label class="rsvp-radio-label">
                                <input type="radio" name="attendance" value="yes" onchange="handleAttendance(this.value)">
                                <span class="rsvp-radio-text" id="txtYes">Z radością przybędę</span>
                            </label>
                            <label class="rsvp-radio-label">
                                <input type="radio" name="attendance" value="no" onchange="handleAttendance(this.value)">
                                <span class="rsvp-radio-text" id="txtNo">Niestety nie będę</span>
                            </label>
                        </div>
                    </div>

                    <!-- KROK: Odmowa -->
                    <div id="step-decline" class="rsvp-step">
                        <h2 class="rsvp-question">Twoja Decyzja</h2>
                        <p style="font-family: var(--font-serif); font-size: 1.3rem; color: var(--text-main); margin-bottom: 2rem; font-style: italic; max-width: 400px; line-height: 1.5;">
                            Przykro nam, że nie będziemy mogli świętować razem.<br>Prosimy o potwierdzenie tej decyzji.
                        </p>
                        <div class="nav-actions">
                            <button type="button" class="submit-btn-elegant" onclick="submitDecline()">
                                <span class="btn-text">Potwierdź odmowę</span>
                            </button>
                            <button type="button" class="back-btn" onclick="goToStep(1)">Wróć</button>
                        </div>
                    </div>

                    <!-- KROK 2: Osoba Towarzysząca -->
                    <div id="step-2" class="rsvp-step">
                        <h2 class="rsvp-question">Czy przybędziesz z Osobą Towarzyszącą?</h2>
                        <div class="rsvp-choice-wrapper">
                            <label class="rsvp-radio-label">
                                <input type="radio" name="plusOne" value="withGuest" onchange="handlePlusOne(true)">
                                <span class="rsvp-radio-text">Tak, przybędziemy razem</span>
                            </label>
                            <label class="rsvp-radio-label">
                                <input type="radio" name="plusOne" value="solo" onchange="handlePlusOne(false)">
                                <span class="rsvp-radio-text">Nie, przybędę sam/sama</span>
                            </label>
                        </div>
                        <div class="nav-actions">
                            <button type="button" class="back-btn" onclick="goToStep(1)">Wróć</button>
                        </div>
                    </div>

                    <!-- KROK 2B: Imię Osoby -->
                    <div id="step-2b" class="rsvp-step">
                        <h2 class="rsvp-question">Jaką godność nosi Twój Gość?</h2>
                        <div class="rsvp-inputs-group">
                            <div class="input-wrapper">
                                <label for="plusOneName">Imię i Nazwisko Osoby Towarzyszącej</label>
                                <input type="text" id="plusOneName" name="plusOneName" placeholder="Wpisz godność..." onkeypress="handleInputEnter(event, 3)">
                            </div>
                        </div>
                        <div class="nav-actions">
                            <button type="button" class="next-arrow-btn" onclick="nextStep(3)">Dalej →</button>
                            <button type="button" class="back-btn" onclick="goToStep(2)">Wróć</button>
                        </div>
                    </div>

                    <!-- KROK 3: Kontakt -->
                    <div id="step-3" class="rsvp-step">
                        <h2 class="rsvp-question">Pozostańmy w kontakcie</h2>
                        <div class="rsvp-inputs-group">
                            <div class="input-wrapper">
                                <label for="phone">Numer Telefonu *</label>
                                <input 
                                    type="tel" 
                                    id="phone" 
                                    name="phone" 
                                    placeholder="np. 600 100 200" 
                                    required
                                    maxlength="11"
                                    oninput="formatPhoneNumber(this)"
                                >
                            </div>
                            <div class="input-wrapper">
                                <label for="email">Adres E-mail (Opcjonalnie)</label>
                                <input type="email" id="email" name="email" placeholder="Twój e-mail...">
                            </div>
                        </div>
                        <div class="nav-actions">
                            <button type="submit" class="submit-btn-elegant">
                                <span class="btn-text">Potwierdź obecność</span>
                            </button>
                            <button type="button" class="back-btn" onclick="goBackFromStep3()">Wróć</button>
                        </div>
                    </div>
                </form>
            </div>

            <!-- SUCCESS MESSAGE -->
            <div id="rsvpSuccessMessage">
                <span class="rsvp-header">Odpowiedź Przyjęta</span>
                <p class="success-text" id="finalSuccessText"></p>
                <div style="margin-top: 3rem; color: var(--gold-light); font-size: 1.5rem;">❦</div>
                
                <div id="successTools" class="success-tools">
                    <div class="calendar-btn-group">
                        <a href="#" onclick="addToGoogleCalendar(event)" class="calendar-styled-link">Dodaj do Google Calendar</a>
                        <a href="#" onclick="downloadICS(event)" class="calendar-styled-link">Dodaj do iCal / Outlook</a>
                    </div>
                    <div class="contact-info-block">
                        W razie pytań pozostajemy do dyspozycji:<br>
                        <a href="tel:+48000000000" class="contact-phone">+48 000 000 000</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 7. COLLECTIVE TEASER (BRIDGE) -->
    <section id="CollectiveTeaser">
        <div class="teaser-wrapper scroll-reveal">
            <span class="teaser-label">Collective Memory</span>
            <p class="teaser-text">
                Najpiękniejsze momenty to te, które dzieją się niepostrzeżenie.<br>
                Jeśli Twoje oko uchwyci taką chwilę – będzie dla nas zaszczytem, jeśli zechcesz ją tutaj pozostawić.
            </p>
            <a href="collective_memory.html" class="teaser-link">
                Dodaj Wspomnienie <span class="teaser-arrow">→</span>
            </a>
        </div>
    </section>

    <!-- 8. FOOTER -->
    <footer id="FinalNote">
        <div class="footer-wrapper scroll-reveal">
            <div class="footer-monogram">W & K</div>
            <div class="footer-message">
                Do zobaczenia wkrótce,<br>
                <span id="footerGuestName"></span>
            </div>
            <div class="footer-end">Concierge Service</div>
        </div>
    </footer>

    <script>
        const INITIAL_DB = {
            'GOSC1': { name: 'Piotrze', full: 'Piotr Nowak', type: 'single' },
            'RODZINA': { name: 'Mamo i Tato', full: 'Kochani Rodzice', type: 'couple' },
            'ANNA': { name: 'Anno', full: 'Anna Kowalska', type: 'single' },
            'PARA': { name: 'Anno i Janie', full: 'Anna i Jan', type: 'couple' }
        };

        const textConfig = {
            single: {
                greetingWord: 'Witamy Cię,', 
                heroPreTitle: 'Twój Osobisty Concierge',
                // ZMIANA: Usunięto drugie zdanie
                heroSentiment: 'Są chwile, które nabierają blasku tylko wtedy, gdy dzielimy je z Najbliższymi.',
                sentimentT1: 'Papierowe zaproszenie było pierwszym, eleganckim gestem. Jako Twój osobisty Concierge, pragnę zadbać o każdy detal tej podróży.',
                sentimentT2: 'Ta cyfrowa przestrzeń powstała, by dopełnienie formalności stało się dla Ciebie czystą przyjemnością i zwieńczeniem przygotowań.',
                sentimentClosing: 'z niecierpliwością oczekujemy Twego przybycia.',
                
                rsvpQuestion: 'Czy zaszczycisz nas swoją obecnością?',
                rsvpYes: 'Z radością przybędę',
                rsvpNo: 'Niestety nie będę',
                decline: 'Rozumiemy i dziękujemy za informację.<br>Będzie nam brakowało Twojej obecności.'
            },
            couple: {
                greetingWord: 'Witamy Was,',
                heroPreTitle: 'Wasz Osobisty Concierge',
                // ZMIANA: Usunięto drugie zdanie
                heroSentiment: 'Są chwile, które nabierają blasku tylko wtedy, gdy dzielimy je z Najbliższymi.',
                sentimentT1: 'Papierowe zaproszenie było pierwszym, eleganckim gestem. Jako Państwa osobisty Concierge, pragnę zadbać o każdy detal tej podróży.',
                sentimentT2: 'Ta cyfrowa przestrzeń powstała, by dopełnienie formalności stało się dla Was czystą przyjemnością i zwieńczeniem przygotowań.',
                sentimentClosing: 'z niecierpliwością oczekujemy Państwa przybycia.',
                
                rsvpQuestion: 'Czy zaszczycicie nas swoją obecnością?',
                rsvpYes: 'Z radością przybędziemy',
                rsvpNo: 'Niestety nie będziemy',
                decline: 'Rozumiemy i dziękujemy za informację.<br>Będzie nam brakowało Waszej obecności.'
            }
        };

        let currentGuestType = 'couple';
        let currentGuestName = '';
        let currentStep = 1;

        try {
            if (!localStorage.getItem('weddingDB')) {
                localStorage.setItem('weddingDB', JSON.stringify(INITIAL_DB));
            }
        } catch(e) { console.log('Storage unavailable'); }
        
        function getDB() {
            try { return JSON.parse(localStorage.getItem('weddingDB')) || INITIAL_DB; }
            catch(e) { return INITIAL_DB; }
        }

        // DOM
        const input = document.getElementById('guestCode');
        const feedback = document.getElementById('gateFeedback');
        // Hero
        const heroPreTitle = document.getElementById('heroPreTitle');
        const heroGuestName = document.getElementById('heroGuestName');
        const heroGreeting = document.querySelector('.hero-greeting');
        const heroSentiment = document.getElementById('heroSentiment');
        // Sentiment
        const sentGuestName = document.getElementById('sentimentGuestName');
        const sentT1 = document.getElementById('sentimentText1');
        const sentT2 = document.getElementById('sentimentText2');
        const sentClose = document.getElementById('sentimentClosingText');
        // RSVP
        const rsvpQuestion = document.getElementById('questionAttendance');
        const rsvpYes = document.getElementById('txtYes');
        const rsvpNo = document.getElementById('txtNo');
        const finalSuccessText = document.getElementById('finalSuccessText');
        const successTools = document.getElementById('successTools');
        // Footer
        const footerGuestName = document.getElementById('footerGuestName');

        // --- ACCESS LOGIC ---
        input.addEventListener('input', (e) => {
            const code = e.target.value.toUpperCase().trim();
            input.classList.remove('input-error');
            feedback.classList.remove('visible');

            const db = getDB();
            if (db.hasOwnProperty(code)) {
                input.blur(); 
                grantAccess(db[code]);
            }
        });

        input.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') {
                const code = input.value.toUpperCase().trim();
                const db = getDB();
                if (!db.hasOwnProperty(code)) {
                    denyAccess();
                }
            }
        });

        function grantAccess(guestData) {
            currentGuestType = guestData.type || 'couple';
            currentGuestName = guestData.name;
            try { localStorage.setItem('wedding_username', guestData.name); } catch(e){}
            
            const texts = textConfig[currentGuestType];

            heroPreTitle.innerText = texts.heroPreTitle;
            heroGuestName.textContent = guestData.name;
            heroGreeting.textContent = texts.greetingWord;
            heroSentiment.innerHTML = texts.heroSentiment;

            sentGuestName.textContent = guestData.name;
            sentT1.textContent = texts.sentimentT1;
            sentT2.textContent = texts.sentimentT2;
            sentClose.textContent = texts.sentimentClosing;

            rsvpQuestion.textContent = texts.rsvpQuestion;
            rsvpYes.textContent = texts.rsvpYes;
            rsvpNo.textContent = texts.rsvpNo;
            
            if(footerGuestName) footerGuestName.textContent = guestData.name;

            document.body.classList.add('access-granted');
            try { localStorage.setItem('wedding_auth', 'true'); } catch(e){}
            
            setTimeout(initScrollObserver, 1000); 
        }

        function denyAccess() {
            input.classList.remove('input-error');
            void input.offsetWidth; 
            input.classList.add('input-error');
            feedback.classList.add('visible');
        }

        // --- ANIMATIONS ---
        function initScrollObserver() {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visible');
                    }
                });
            }, { threshold: 0.15 }); 
            document.querySelectorAll('.scroll-reveal').forEach(el => observer.observe(el));
        }

        // --- RSVP NAVIGATION ---
        function changeStep(newStep) {
            let currentIdSuffix = currentStep; 
            const currentEl = document.getElementById(`step-${currentStep}`);
            let nextStepIdSuffix = (typeof newStep === 'string' && newStep.startsWith('step-')) ? newStep.replace('step-', '') : newStep;
            const nextEl = document.getElementById(`step-${nextStepIdSuffix}`);

            if (!currentEl) {
                if (nextEl) {
                    resetToStep(nextEl, nextStepIdSuffix);
                }
                return;
            }

            currentEl.style.opacity = '0';
            currentEl.style.transform = 'translateY(-20px)';
            
            setTimeout(() => {
                currentEl.classList.remove('active');
                currentEl.style.display = 'none'; 
                if (nextEl) {
                    nextEl.style.display = 'flex'; 
                    void nextEl.offsetWidth;
                    nextEl.classList.add('active');
                    nextEl.style.opacity = '1';
                    nextEl.style.transform = 'translateY(0)';
                }
                currentStep = nextStepIdSuffix; 
            }, 600); 
        }

        function resetToStep(el, stepId) {
            document.querySelectorAll('.rsvp-step').forEach(s => {
                s.style.display = 'none';
                s.classList.remove('active');
            });
            el.style.display = 'flex';
            setTimeout(() => {
                el.classList.add('active');
                el.style.opacity = '1';
                el.style.transform = 'translateY(0)';
            }, 50);
            currentStep = stepId;
        }

        function handleAttendance(val) {
            if (val === 'no') changeStep('decline'); 
            else if (currentGuestType === 'single') changeStep(2);
            else changeStep(3);
        }

        function handlePlusOne(hasPlusOne) {
            if (hasPlusOne) changeStep('2b'); else changeStep(3);
        }
        
        function nextStep(n) { changeStep(n); }
        function goToStep(n) { changeStep(n); }
        function submitDecline() { showSuccessState(true); }
        function handleInputEnter(e, nextStepNum) { if (e.key === 'Enter') { e.preventDefault(); nextStep(nextStepNum); } }
        function goBackFromStep3() {
            if (currentGuestType === 'single') {
                const plusOneRadio = document.querySelector('input[name="plusOne"]:checked');
                if (plusOneRadio && plusOneRadio.value === 'withGuest') changeStep('2b'); else changeStep(2);
            } else { changeStep(1); }
        }

        // Formatowanie Telefonu
        function formatPhoneNumber(input) {
            let value = input.value.replace(/\D/g, '');
            if (value.length > 9) value = value.substring(0, 9);
            if (value.length > 0) {
                value = value.match(new RegExp('.{1,3}', 'g')).join(' ');
            }
            input.value = value;
        }

        document.getElementById('rsvpForm').addEventListener('submit', (e) => { e.preventDefault(); showSuccessState(false); });

        function showSuccessState(isDeclined) {
            const formContainer = document.getElementById('rsvpContent');
            const successMsg = document.getElementById('rsvpSuccessMessage');
            const texts = textConfig[currentGuestType];
            
            if (isDeclined) {
                finalSuccessText.innerHTML = texts.decline;
                successTools.style.display = 'none'; 
            } else {
                let msg = (currentGuestType === 'single') ? 
                    `Cieszymy się, że będziesz z nami ${currentGuestName}!<br>Twoja obecność została potwierdzona.` :
                    `Cieszymy się, że będziecie z nami ${currentGuestName}!<br>Wasza obecność została potwierdzona.`;
                finalSuccessText.innerHTML = msg;
                successTools.style.display = 'flex'; 
            }

            formContainer.style.opacity = '0';
            setTimeout(() => {
                formContainer.style.display = 'none';
                successMsg.style.display = 'flex';
                void successMsg.offsetWidth;
                successMsg.classList.add('visible');
            }, 800);
        }

        const eventData = { title: "Ślub Wiktorii i Kamila", start: "20270808T150000", end: "20270809T040000" };
        function addToGoogleCalendar(e) { e.preventDefault(); window.open(`https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(eventData.title)}&dates=${eventData.start}/${eventData.end}`, '_blank'); }
        function downloadICS(e) { e.preventDefault(); alert("Pobieranie ICS..."); }

    </script>
</body>
